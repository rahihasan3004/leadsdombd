{
  "name": "@fine-leads/scraper-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./config": "./src/config/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "node --env-file=\"../../.env\" --import tsx src/cli.ts",
    "test:db": "tsx src/test-db-connection.ts",
    "db:reset-agents": "node --env-file=\"../../.env\" --import tsx src/scripts/reset-agents.ts",
    "test:e2e": "node --env-file=\"../../.env\" --import tsx src/test-e2e-pipeline.ts",
    "test:focused": "tsx src/test-focused-pipeline.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "playwright": "^1.48.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fine-leads/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-turbo": "^2.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}