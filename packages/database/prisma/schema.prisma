generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
  PAUSED
}

enum AgentLicenseStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
  PENDING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATING
  CLOSED
  LOST
  ARCHIVED
}

enum ExportFormat {
  CSV
  EXCEL
  JSON
  PDF
}

enum WalletTransactionType {
  RECHARGE
  CHARGE
  REFUND
  BONUS
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users         User[]
  subscriptions Subscription[]
  apiKeys       ApiKey[]
  searchHistory SearchHistory[]
  savedLists    SavedList[]

  @@index([slug])
}

model User {
  id               String              @id @default(cuid())
  name             String?
  email            String              @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             UserRole            @default(USER)
  walletBalance    Decimal             @default(0) @db.Decimal(12, 2)
  tokenVersion     Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id])
  accounts         Account[]
  sessions         Session[]
  subscriptions    Subscription[]
  apiKeys          ApiKey[]
  searchHistory    SearchHistory[]
  savedLists       SavedList[]
  leadExports      LeadExport[]
  purchases        LeadPurchase[]
  walletTransactions WalletTransaction[]

  @@index([organizationId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id             String    @id @default(cuid())
  identifier     String
  token          String    @unique
  expires        DateTime
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  quantity             Int                @default(1)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([stripeCustomerId])
}

model ApiKey {
  id             String       @id @default(cuid())
  name           String
  prefix         String
  hashedKey      String       @unique
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([hashedKey])
  @@index([userId])
  @@index([organizationId])
}

model SearchHistory {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  query          Json
  resultCount    Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
}

model SavedList {
  id             String       @id @default(cuid())
  name           String
  description    String?
  query          Json
  agentCount     Int          @default(0)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([organizationId])
}

model LeadExport {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  format      ExportFormat @default(CSV)
  agentCount  Int
  fileUrl     String?
  status      ExportStatus @default(PENDING)
  searchQuery Json
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

model Agent {
  id                String             @id @default(cuid())
  fullName          String
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  officePhone       String?
  licenseNumber     String?
  licenseState      String?
  licenseStatus     AgentLicenseStatus @default(ACTIVE)
  licenseExpiry     DateTime?
  nmlsId            String?
  brokerageName     String?
  brokerageAddress  String?
  city              String?
  state             String?
  zipCode           String?
  county            String?
  marketArea        String?
  propertyTypes     String[]
  transactionCount  Int                @default(0)
  totalVolume       Decimal             @default(0) @db.Decimal(12, 2)
  averagePrice      Decimal             @default(0) @db.Decimal(12, 2)
  yearsExperience   Int                @default(0)
  specializations   String[]
  bio               String?
  photoUrl          String?
  websiteUrl        String?
  socialProfiles    Json?
  dataSource        String?
  lastVerifiedAt    DateTime?
  verificationScore Int                @default(0)
  isVerified        Boolean            @default(false)
  timezone          String?
  category          String?
  googleMainCategory String?
  googleSubcategories String?
  rating            Float?
  reviewCount       Int?
  scrapedAt         DateTime?
  emailStatus       String?
  isDeliverable     Boolean            @default(true)
  googlePlaceId     String?
  googleMapsLink    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  agentActivities   AgentActivity[]

  @@index([state])
  @@index([licenseState, licenseNumber])
  @@index([city, state])
  @@index([brokerageName])
  @@index([isVerified])
  @@index([verificationScore])
  @@index([fullName])
  @@index([googlePlaceId])
  @@index([email])
  @@index([isDeliverable])
  @@index([dataSource])
  @@index([category])
  @@index([state, category])
  @@unique([googlePlaceId])
  @@index([email])
}

model AgentActivity {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String
  details   Json?
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  provider    String    @default("lemonsqueezy")
  processedAt DateTime  @default(now())
  status      String
  payload     Json?

  @@index([eventId])
  @@index([provider, processedAt])
}

model LeadPurchase {
  id              String         @id @default(cuid())
  referenceId     String         @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  state           String?
  unlockedStates  String[]
  amountPaid      Decimal          @default(0) @db.Decimal(12, 2)
  status          PurchaseStatus @default(COMPLETED)
  stripeSessionId String?
  refundedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model WalletTransaction {
  id              String                @id @default(cuid())
  referenceId     String                @unique
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            WalletTransactionType @default(RECHARGE)
  amount          Decimal                 @default(0) @db.Decimal(12, 2)
  balanceAfter    Decimal?                @db.Decimal(12, 2)
  description     String
  status          TransactionStatus     @default(COMPLETED)
  stripeSessionId String?
  metadata        Json?
  createdAt       DateTime              @default(now())

  @@index([userId])
  @@index([createdAt])
}
