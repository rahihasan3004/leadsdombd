# ─── Application ───────────────────────────────────
NEXT_PUBLIC_APP_URL=https://getleadsdom.com
NODE_ENV=production

# ─── Database (PostgreSQL) ─────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ─── Auth.js ───────────────────────────────────────
AUTH_SECRET="generate-a-random-secret-at-least-32-chars"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="https://getleadsdom.com"
NEXTAUTH_URL="https://getleadsdom.com"

# ─── Stripe ────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_YEARLY="price_..."

# ─── Email (Resend) ────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@getleadsdom.com"

# ─── Redis (Upstash) ───────────────────────────────
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Monitoring ────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# ─── SMTP (optional) ───────────────────────────────
SMTP_HELO_DOMAIN="getleadsdom.com"
