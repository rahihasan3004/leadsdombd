# ─── Application ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database (PostgreSQL) ─────────────────────────
DATABASE_URL="postgresql://username:password@postgres:5432/dbname?schema=public"
DIRECT_URL="postgresql://username:password@postgres:5432/dbname?schema=public"

# ─── Auth.js ───────────────────────────────────────
AUTH_SECRET="generate-a-random-secret-at-least-32-chars"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# ─── Lemon Squeezy ──────────────────────────────────
LEMONSQUEEZY_API_KEY="your-lemonsqueezy-api-key"
LEMONSQUEEZY_STORE_ID="481404"
LEMONSQUEEZY_WEBHOOK_SECRET="your-lemonsqueezy-webhook-signing-secret"
LEMONSQUEEZY_WALLET_TOPUP_VARIANT_ID="2160121"
LEMONSQUEEZY_LEAD_PURCHASE_VARIANT_ID="2160134"

# ─── Stripe (deprecated — kept for migration reference) ──
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# STRIPE_PRICE_PRO_YEARLY="price_..."
# STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
# STRIPE_PRICE_ENTERPRISE_YEARLY="price_..."

# ─── Email (Resend) ────────────────────────────────
RESEND_API_KEY="re_placeholder_your_api_key_here"
RESEND_FROM_EMAIL="LeadsDom <onboarding@resend.dev>"

# ─── Redis (Upstash) ───────────────────────────────
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Monitoring ────────────────────────────────────
SENTRY_DSN=""
# Server-only Apify Compass (optional; Lobstr remains the default)
APIFY_TOKEN=
APIFY_TOKENS=
APIFY_FULFILLMENT_ENABLED=false
SCRAPER_PROVIDER=lobstr
SCRAPER_FALLBACK_PROVIDER=
APIFY_MAX_RUN_CHARGE_USD=1
APIFY_SCRAPE_CONTACTS=false

# Apify staged email eligibility (no local port-25 SMTP). syntax | mx | api
APIFY_EMAIL_VALIDATION_MODE=syntax
# Optional trusted HTTPS validator/VPS (api mode only), never NEXT_PUBLIC_.
APIFY_EMAIL_VALIDATOR_URL=
APIFY_EMAIL_VALIDATOR_TOKEN=
